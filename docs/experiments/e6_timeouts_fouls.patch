diff --git a/pipeline/features.py b/pipeline/features.py
index a5d8d7b..2abf1cd 100644
--- a/pipeline/features.py
+++ b/pipeline/features.py
@@ -52,8 +52,27 @@ FEATURES = [
     "home_possession",
     "strength_gap",
     "margin_x_time",
+    "home_timeouts",
+    "away_timeouts",
+    "home_fouls_to_give",
+    "away_fouls_to_give",
 ]
 
+# Typical timeouts left and fouls to give by seconds left in regulation (medians
+# over 2021-26), for what-if states that don't say: (up to seconds, timeouts, fouls to give).
+TYPICAL_COUNTS = [(30, 1, 0), (180, 2, 0), (720, 3, 2), (1440, 4, 2), (2160, 5, 2), (2880, 6, 2)]
+
+
+def typical_counts(seconds_left, is_ot=0) -> tuple:
+    """(timeouts left, fouls to give) a team typically has at this point: arrays in, arrays out."""
+    t = np.asarray(seconds_left, dtype=float)
+    edges = np.array([e for e, _, _ in TYPICAL_COUNTS])
+    i = np.clip(np.searchsorted(edges, t, side="left"), 0, len(edges) - 1)
+    timeouts = np.array([to for _, to, _ in TYPICAL_COUNTS])[i]
+    fouls = np.array([fg for _, _, fg in TYPICAL_COUNTS])[i]
+    ot = np.asarray(is_ot) == 1
+    return np.where(ot, np.where(t <= 30, 1, 2), timeouts), np.where(ot, np.where(t <= 180, 0, 2), fouls)
+
 _FT_RE = r"(\d)\s+OF\s+(\d)"
 
 
